{
  "name": "firefly2-sim",
  "private": true,
  "description": "Dev tooling for the browser simulator (sim/). Viewing the simulator has no runtime dependencies or build step.",
  "type": "module",
  "scripts": {
    "check:agents": "node scripts/check-agent-setup.mjs",
    "build:sim-wasm": "node scripts/simulator-wasm.mjs build",
    "check:sim-wasm": "node scripts/simulator-wasm.mjs check",
    "lint": "eslint sim playwright.config.mjs scripts/serve-simulator-e2e.mjs",
    "lint:fix": "eslint --fix sim playwright.config.mjs scripts/serve-simulator-e2e.mjs",
    "test": "node --test \"sim/test/cases/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:report": "playwright show-report",
    "test:sim-wasm-artifact": "node --test sim/test/cases/artifact.test.mjs",
    "test:sim-wasm-integration": "node scripts/simulator-wasm.mjs test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@stylistic/eslint-plugin": "^3.1.0",
    "eslint": "^9.20.0"
  }
}
